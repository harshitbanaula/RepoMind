# App
APP_ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=change-me-32-bytes-min
FERNET_KEY=generate-with-cryptography.fernet.Fernet.generate_key()
JWT_SECRET=change-me-too
JWT_EXPIRE_MINUTES=60

# Postgres
POSTGRES_USER=repo
POSTGRES_PASSWORD=repo
POSTGRES_DB=repo_copilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://repo:repo@postgres:5432/repo_copilot

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT=http://localhost:8000/auth/github/callback
GITHUB_WEBHOOK_SECRET=

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b


# MCP
MCP_GITHUB_SERVER_CMD=python -m app.mcp_servers.github_server
MCP_REPO_SEARCH_SERVER_CMD=python -m app.mcp_servers.repo_search_server